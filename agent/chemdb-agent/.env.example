# chemdb-agent 环境变量占位。真实值只放在本地 .env，不提交到 git。
# 复制本文件为 .env 后按需填写（服务器启动时自动读取项目目录下的 .env）：
#   cp .env.example .env        （Windows：copy .env.example .env）

# 可选：Materials Project API key（https://next-gen.materialsproject.org/api 免费注册后申请）
# 不填时 mp 数据库不可用，其余数据源照常；MP 的结构可用 optimade-mp 查到（无能量）
MP_API_KEY=

# 可选：数据目录（缓存、下载的分片、导出的训练集），默认是项目目录下的 data/
# CHEMDB_DATA_DIR=

# 可选：单次 HTTP 请求超时（秒，默认 30）、单个数据源一次查询的总时限（秒，默认 90）
# CHEMDB_HTTP_TIMEOUT=30
# CHEMDB_SOURCE_TIMEOUT=90

# 可选：记录缓存的有效期（秒，默认 604800 即 7 天；0 表示不读缓存）
# CHEMDB_CACHE_TTL=604800
