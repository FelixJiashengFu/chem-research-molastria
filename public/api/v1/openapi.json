{
 "openapi": "3.1.0",
 "info": {
  "title": "MolAstria open data API",
  "version": "1.0",
  "description": "Static, read-only JSON: no key, no sign-up, no rate limit, CORS open. Each dataset is one whole file; filter on your side. Text fields are bilingual objects { zh, en }. Schemas are inferred from the published data.",
  "license": {
   "name": "Creative Commons Attribution 4.0 International",
   "identifier": "CC-BY-4.0"
  },
  "contact": {
   "url": "https://molastria.com/api/"
  }
 },
 "servers": [
  {
   "url": "https://molastria.com/api/v1"
  }
 ],
 "paths": {
  "/index.json": {
   "get": {
    "operationId": "listDatasets",
    "summary": "List every dataset with its entry count and check date",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/index"
        }
       }
      }
     }
    }
   }
  },
  "/resources.json": {
   "get": {
    "operationId": "get_resources",
    "summary": "Resource catalogue: databases, software, datasets and courses (214 entries, whole file)",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/resources"
        }
       }
      }
     }
    }
   }
  },
  "/journals.json": {
   "get": {
    "operationId": "get_journals",
    "summary": "Journal guide: computational-chemistry journals and preprint servers (48 entries, whole file)",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/journals"
        }
       }
      }
     }
    }
   }
  },
  "/scimodels.json": {
   "get": {
    "operationId": "get_scimodels",
    "summary": "Science foundation models: model cards and official prices (27 entries, whole file)",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/scimodels"
        }
       }
      }
     }
    }
   }
  },
  "/videos.json": {
   "get": {
    "operationId": "get_videos",
    "summary": "Teaching videos: courses and tutorials on YouTube and Bilibili (189 entries, whole file)",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/videos"
        }
       }
      }
     }
    }
   }
  },
  "/terms.json": {
   "get": {
    "operationId": "get_terms",
    "summary": "Term table: computational-chemistry synonyms in Chinese and English (109 entries, whole file)",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/terms"
        }
       }
      }
     }
    }
   }
  }
 },
