  "/v1/jobs": {
   "servers": [
    {
     "url": "https://api.molastria.com",
     "description": "Account service (the compute API)"
    }
   ],
   "post": {
    "operationId": "computeSubmit",
    "tags": [
     "compute"
    ],
    "summary": "Queue a calculation; answers at once with the job id. Poll GET /v1/jobs/{id}.",
    "security": [
     {
      "apiKey": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ComputeJobRequest"
       },
       "example": {
        "smiles": "CCO",
        "job": "opt",
        "model": "uma-s-1p2p1"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "A result the service had already computed (cached: true)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeJob"
        }
       }
      }
     },
     "202": {
      "description": "Queued",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeJob"
        }
       }
      }
     },
     "400": {
      "description": "A field is missing or outside its range",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     },
     "401": {
      "description": "No key, or a key that is not valid",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     },
     "403": {
      "description": "A model whose licence does not allow the API (licence)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     },
     "429": {
      "description": "Out of uses for today (quota_exceeded), a job already queued or running (job_in_progress), or the API as a whole is at its total for today (api_busy)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     },
     "503": {
      "description": "The GPU is offline (offline) or the API is switched off (unavailable)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     }
    }
   }
  },
  "/v1/jobs/{id}": {
   "servers": [
    {
     "url": "https://api.molastria.com",
     "description": "Account service (the compute API)"
    }
   ],
   "get": {
    "operationId": "computeJob",
    "tags": [
     "compute"
    ],
    "summary": "The state of a job: queued, running, done (with result) or error. Finished jobs are kept for an hour.",
    "security": [
     {
      "apiKey": []
     }
    ],
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{16}$"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeJob"
        }
       }
      }
     },
     "401": {
      "description": "No key, or a key that is not valid",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     },
     "404": {
      "description": "No such job",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     },
     "503": {
      "description": "The GPU is offline (offline) or the API is switched off (unavailable)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ComputeError"
        }
       }
      }
     }
    }
   }
  }
 },
