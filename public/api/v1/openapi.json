   "ComputeJobRequest": {
    "type": "object",
    "description": "Exactly one of smiles and xyz (a reaction brings its species in params.reaction instead). At most 30 heavy atoms and 120 atoms.",
    "properties": {
     "job": {
      "type": "string",
      "enum": [
       "sp",
       "opt",
       "freq",
       "conf",
       "scan",
       "md",
       "rxn",
       "ipea",
       "spin",
       "bde",
       "pa"
      ],
      "default": "ipea",
      "description": "sp single point, opt optimisation, freq frequencies and thermochemistry, conf conformer search, scan dihedral scan, md molecular dynamics, rxn reaction energy, ipea ionisation energy and electron affinity, spin spin-state gaps, bde bond dissociation energy, pa proton affinity. GET /v1/models says which model does which."
     },
     "model": {
      "type": "string",
      "enum": [
       "uma-s-1p2p1",
       "uma-s-1p2",
       "uma-s-1p2p1-ft-d4rev",
       "uma-s-1p1",
       "allscaip-md-conserving-all-omol",
       "allscaip-md-direct-all-omol",
       "esen-sm-conserving-all-omol",
       "esen-sm-direct-all-omol",
       "esen-md-direct-all-omol",
       "ani-2x"
      ],
      "default": "uma-s-1p2p1"
     },
     "smiles": {
      "type": "string",
      "maxLength": 200
     },
     "xyz": {
      "type": "string",
      "maxLength": 12000,
      "description": "Standard XYZ text: atom count, a comment line, then \"symbol x y z\" lines."
     },
     "charge": {
      "type": "integer",
      "minimum": -2,
      "maximum": 2,
      "default": 0
     },
     "spin": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "Spin multiplicity. Models that are not \"charged\" take 0 and 1 only."
     },
     "params": {
      "type": "object",
      "description": "Per job, all optional unless marked: opt {fmax}; freq {temperature, symmetry}; conf {n, temperature, window_kcal}; scan {atoms (required, four atom indices), start, end, points}; md {temperature, timestep_fs, steps, friction}; rxn {reaction (required, reaction SMILES), thermo, temperature}; ipea {mode}; spin {spins}; bde {bond (required, two atom indices), thermo, temperature}; pa {site (required, atom index), mode, thermo, temperature}."
     }
    },
    "required": [
     "job"
    ]
   },
