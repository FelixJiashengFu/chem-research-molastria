{
 "openapi": "3.1.0",
 "info": {
  "title": "MolAstria API: open data and compute",
  "version": "1.0",
  "description": "Two parts. Open data (tag \"open data\"): static, read-only JSON, no key, no sign-up, no rate limit, CORS open; each dataset is one whole file, filter on your side; text fields are bilingual objects { zh, en }; schemas are inferred from the published data. Compute (tag \"compute\", server https://api.molastria.com): calculations with machine-learned potentials for a free API key made on https://molastria.com/pro/account.html; submit, then poll. The compute is the RTX 2080 in the site owner's computer: best effort, and it may be offline. Do not build anything with a deadline on it.",
  "license": {
   "name": "Creative Commons Attribution 4.0 International",
   "identifier": "CC-BY-4.0"
  },
  "contact": {
   "url": "https://molastria.com/api/"
  }
 },
 "servers": [
  {
   "url": "https://molastria.com/api/v1",
   "description": "Open data (static files)"
  }
 ],
 "tags": [
  {
   "name": "open data"
  },
  {
   "name": "compute",
   "description": "The compute is the RTX 2080 in the site owner's computer: best effort, and it may be offline. Do not build anything with a deadline on it."
  }
 ],
 "paths": {
  "/index.json": {
   "get": {
    "operationId": "listDatasets",
    "summary": "List every dataset with its entry count and check date",
    "responses": {
